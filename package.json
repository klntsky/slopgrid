{
  "name": "slopgrid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "pnpm build && tsx tests/run-e2e.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src server tests *.ts *.json *.md pnpm-workspace.yaml"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "ai": "7.0.136",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "lucide-react": "1.55.0",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.4.2"
}
