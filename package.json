{
  "name": "slopgrid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc --noEmit && NODE_ENV=production vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "pnpm build && pnpm test:built",
    "test:e2e": "tsx tests/run-e2e.ts --suite all",
    "check": "tsc --noEmit",
    "format": "prettier --write src server tests *.ts *.json *.md pnpm-workspace.yaml",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e:mock": "tsx tests/run-e2e.ts --suite mock",
    "test:e2e:github": "tsx tests/run-e2e.ts --suite github",
    "test:e2e:real": "tsx tests/run-e2e.ts --suite real",
    "test:built": "pnpm test:unit && tsx tests/run-e2e.ts --suite all --reuse-build",
    "start:engine": "NODE_ENV=production tsx server/engine.ts",
    "generation": "tsx server/generation-control.ts"
  },
  "dependencies": {
    "@octokit/oauth-methods": "6.0.5",
    "@octokit/request": "10.0.16",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@openrouter/sdk": "1.4.25",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "ai": "7.0.136",
    "better-sqlite3": "13.0.3",
    "decode-named-character-reference": "1.3.0",
    "es-module-lexer": "^3.0.3",
    "express": "5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "1.55.0",
    "oauth4webapi": "3.8.8",
    "parse5": "8.0.0",
    "postcss": "^8.5.30",
    "postcss-value-parser": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tippy.js": "^6.3.7",
    "undici": "^7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.4.2"
}
